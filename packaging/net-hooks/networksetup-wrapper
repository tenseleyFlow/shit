#!/usr/bin/env bash
# shit networksetup wrapper (macOS). PATH-prepended via the shell
# hook so `networksetup -setdnsservers ...` invocations route
# through here. Mutating verbs fire a `net-event networksetup pre /
# post` bracket; non-mutating verbs (`-get*`, `-list*`,
# `-print*`, `-info*`) pass through unchanged.
#
# M06.1 — DNS-only first ship. Wrapper handles `-setdnsservers
# <service> <dns...>` and uses `<service>` as the scope_hint so
# the inspector queries the right service's pre-state.
#
# SPDX-License-Identifier: AGPL-3.0-or-later

set -u
depth="${SHIT_WRAPPER_DEPTH:-0}"
if [[ "$depth" -ge 2 ]]; then
    echo "shit-networksetup-wrapper: loop detected (depth=$depth); refusing" >&2
    exit 127
fi
export SHIT_WRAPPER_DEPTH=$((depth + 1))

HELPER="${SHIT_HELPER:-/usr/local/bin/shit-helper}"
self_realpath="$(readlink -f "$0" 2>/dev/null || echo "$0")"

real=""
for cand in /usr/sbin/networksetup; do
    if [[ -x "$cand" ]]; then
        cand_real="$(readlink -f "$cand" 2>/dev/null || echo "$cand")"
        if [[ "$cand_real" != "$self_realpath" ]]; then
            real="$cand"
            break
        fi
    fi
done
if [[ -z "$real" ]]; then
    echo "shit-networksetup-wrapper: real networksetup not found at /usr/sbin/networksetup" >&2
    exit 127
fi

# Reentrancy: when an undo is running we must NOT bracket; just
# pass through so the executor's `networksetup -setdnsservers`
# restore call doesn't re-trigger capture.
if [[ -n "${SHIT_DURING_UNDO:-}" ]]; then
    exec "$real" "$@"
fi

verb="${1:-}"

# Classify verb. M06.5 adds setmanual/setdhcp/switchtolocation to
# the M06.1 setdnsservers-only ship. The scope (service name vs.
# global) differs per verb:
#
#   -setdnsservers <svc> <dns...>       — service = $2
#   -setmanual <svc> <ip> <mask> <gw>   — service = $2
#   -setdhcp <svc>                      — service = $2
#   -switchtolocation <name>            — no service (global)
mutating=0
needs_service=0
case "$verb" in
    -setdnsservers|-setmanual|-setdhcp)
        mutating=1
        needs_service=1
        ;;
    -switchtolocation)
        mutating=1
        needs_service=0
        ;;
esac

if [[ "$mutating" -eq 1 ]]; then
    service=""
    if [[ "$needs_service" -eq 1 ]]; then
        service="${2:-}"
        if [[ -z "$service" ]]; then
            # Mutating verb invoked without a service argument —
            # the real networksetup will reject it. Pass through so
            # the user sees the canonical error rather than us
            # silently bracketing nothing.
            exec "$real" "$@"
        fi
    fi
    # Strip the leading `-` from the verb (clap-friendly).
    verb_arg="${verb#-}"
    "$HELPER" net-event networksetup pre "--verb=$verb_arg" "--scope-hint=$service" 2>/dev/null || true
    "$real" "$@"
    rc=$?
    "$HELPER" net-event networksetup post "--verb=$verb_arg" "--scope-hint=$service" 2>/dev/null || true
    exit "$rc"
fi

# Non-mutating or unrecognized: pass through.
exec "$real" "$@"
