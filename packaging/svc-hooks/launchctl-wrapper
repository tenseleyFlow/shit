#!/usr/bin/env bash
# shit launchctl wrapper — installed as $XDG_CONFIG_HOME/shit/bin/launchctl
# and PATH-prepended by the shell hook (macOS).
#
# Mirrors the systemctl-wrapper structure. launchctl's CLI is more
# heterogeneous; we recognise the mutating verbs and extract the
# target (which encodes scope + label):
#
#     launchctl bootstrap gui/<uid> /path/to.plist
#     launchctl bootout gui/<uid>/com.example.foo
#     launchctl enable system/com.example.foo
#     launchctl kickstart gui/<uid>/com.example.foo
#
# SPDX-License-Identifier: AGPL-3.0-or-later

set -u

depth="${SHIT_WRAPPER_DEPTH:-0}"
if [[ "$depth" -ge 2 ]]; then
    echo "shit-launchctl-wrapper: loop detected (depth=$depth); refusing" >&2
    exit 127
fi
export SHIT_WRAPPER_DEPTH=$((depth + 1))

HELPER="${SHIT_HELPER:-/usr/local/bin/shit-helper}"

real_launchctl=""
self_realpath="$(readlink -f "$0" 2>/dev/null || echo "$0")"
for cand in /bin/launchctl /usr/bin/launchctl; do
    if [[ -x "$cand" ]]; then
        cand_real="$(readlink -f "$cand" 2>/dev/null || echo "$cand")"
        if [[ "$cand_real" != "$self_realpath" ]]; then
            real_launchctl="$cand"
            break
        fi
    fi
done

if [[ -z "$real_launchctl" ]]; then
    echo "shit-launchctl-wrapper: real launchctl not found" >&2
    exit 127
fi

if [[ -n "${SHIT_DURING_UNDO:-}" ]]; then
    exec "$real_launchctl" "$@"
fi

verb="${1:-}"
target="${2:-}"

mutating=0
case "$verb" in
    bootstrap|bootout|enable|disable|kickstart|kill|start|stop|reboot-user|load|unload)
        mutating=1
        ;;
esac

scope="launchd-gui"
unit=""
if [[ -n "$target" ]]; then
    # target shapes:
    #   gui/<uid>/<label>
    #   gui/<uid>            (bootstrap form; label comes from the plist)
    #   system/<label>
    #   system
    #   /path/to.plist        (legacy)
    if [[ "$target" == system/* ]]; then
        scope="launchd-system"
        unit="${target#system/}"
    elif [[ "$target" == system ]]; then
        scope="launchd-system"
        unit=""
    elif [[ "$target" == gui/* ]]; then
        scope="launchd-gui"
        # Strip the gui/<uid>/ prefix to get the label.
        rest="${target#gui/}"
        unit="${rest#*/}"
        # If there was no trailing label (target was gui/<uid>), unit
        # is the same as rest — clear it.
        if [[ "$unit" == "$rest" ]]; then
            unit=""
        fi
    fi
fi

if [[ "$mutating" -eq 1 && -n "$unit" ]]; then
    "$HELPER" svc-event launchctl pre --scope "$scope" --unit "$unit" --verb "$verb" 2>/dev/null || true
    "$real_launchctl" "$@"
    rc=$?
    "$HELPER" svc-event launchctl post --scope "$scope" --unit "$unit" --verb "$verb" 2>/dev/null || true
    exit "$rc"
else
    exec "$real_launchctl" "$@"
fi
