#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
# C03 cloud wrapper: terraform. PATH-prepended under
# $XDG_CONFIG_HOME/shit/bin/ when `shit cloud-hooks install` runs.
#
# Pre/post capture invocations of `shit-helper cloud-event terraform ...`
# are gated on DR-CR-06 (daemon-side capture pipeline). Stage 1 just
# execs the real terraform with SHIT_DURING_UNDO recursion guard.

set -e

# Recursion guard: a terraform invocation issued FROM the helper
# itself (during a shit undo) must NOT re-capture. The executors set
# SHIT_DURING_UNDO=1.
if [ "${SHIT_DURING_UNDO:-}" = "1" ]; then
    real=$(PATH="${PATH#*$(dirname "$0"):}" command -v terraform 2>/dev/null || command -v -- terraform)
    [ -n "$real" ] || { echo "shit: real terraform not found on PATH" >&2; exit 127; }
    exec "$real" "$@"
fi

# Locate the real terraform (first non-wrapper entry on PATH).
real=$(PATH="${PATH#*$(dirname "$0"):}" command -v terraform 2>/dev/null || command -v -- terraform)
[ -n "$real" ] || { echo "shit: real terraform not found on PATH" >&2; exit 127; }

# DR-CR-06 (AR04 PR-B): pre-capture via `shit-helper cloud-event`.
# Helper classifies argv, runs `terraform state pull` for Apply /
# Destroy, ships prior_state + verb descriptors via ctl. Hook-
# friendly: failure logs and returns 0 so a torn daemon cannot break
# `terraform`.
helper=$(command -v shit-helper 2>/dev/null || true)
if [ "${SHIT_HOOK_DEBUG:-}" = "1" ]; then
    echo "shit-hook: terraform-wrapper real=${real} helper=${helper:-<not-found>}" >&2
fi
if [ -n "$helper" ]; then
    target_argv=$(printf '%s\n' "$@")
    "$helper" cloud-event terraform pre --target-argv "$target_argv" || true
fi

exec "$real" "$@"
