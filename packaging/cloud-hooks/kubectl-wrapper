#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
# C03 cloud wrapper: kubectl. PATH-prepended under
# $XDG_CONFIG_HOME/shit/bin/ when `shit cloud-hooks install` runs.
#
# Pre/post capture invocations of `shit-helper cloud-event kubectl ...`
# are gated on DR-CR-06 (daemon-side capture pipeline). Stage 1 just
# execs the real kubectl with SHIT_DURING_UNDO recursion guard.

set -e

# Recursion guard: a kubectl invocation issued FROM the helper itself
# (during a shit undo) must NOT re-capture. The executors set
# SHIT_DURING_UNDO=1.
if [ "${SHIT_DURING_UNDO:-}" = "1" ]; then
    real=$(PATH="${PATH#*$(dirname "$0"):}" command -v kubectl 2>/dev/null || command -v -- kubectl)
    [ -n "$real" ] || { echo "shit: real kubectl not found on PATH" >&2; exit 127; }
    exec "$real" "$@"
fi

# Locate the real kubectl (first non-wrapper entry on PATH).
real=$(PATH="${PATH#*$(dirname "$0"):}" command -v kubectl 2>/dev/null || command -v -- kubectl)
[ -n "$real" ] || { echo "shit: real kubectl not found on PATH" >&2; exit 127; }

# DR-CR-06 (AR04.3): pre-capture via `shit-helper cloud-event`. Helper
# classifies argv, runs `kubectl get -o yaml <kind>/<name>` for
# destructive verbs, ships captured YAML + identifiers via ctl.
# Hook-friendly: failure logs and returns 0.
helper=$(command -v shit-helper 2>/dev/null || true)
if [ "${SHIT_HOOK_DEBUG:-}" = "1" ]; then
    echo "shit-hook: kubectl-wrapper real=${real} helper=${helper:-<not-found>}" >&2
fi
if [ -n "$helper" ]; then
    target_argv=$(printf '%s\n' "$@")
    # `--target-argv=...` (equals syntax) instead of
    # `--target-argv "..."` so clap doesn't try to parse a
    # leading `--flag` in the value as a new flag (happens when
    # the user passes global flags first, e.g.
    # `kubectl --context X delete ...`).
    "$helper" cloud-event kubectl pre "--target-argv=$target_argv" || true
fi

exec "$real" "$@"
