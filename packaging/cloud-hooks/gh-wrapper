#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
# C03 cloud wrapper: gh (GitHub CLI). PATH-prepended under
# $XDG_CONFIG_HOME/shit/bin/ when `shit cloud-hooks install` runs.
#
# Pre/post capture invocations of `shit-helper cloud-event gh ...`
# are gated on DR-CR-06 (daemon-side capture pipeline). Stage 1 just
# execs the real gh with SHIT_DURING_UNDO recursion guard.

set -e

# Recursion guard: a gh invocation issued FROM the helper itself
# (during a shit undo) must NOT re-capture. The executors set
# SHIT_DURING_UNDO=1.
if [ "${SHIT_DURING_UNDO:-}" = "1" ]; then
    real=$(command -v -- gh | grep -v "$(dirname "$0")" | head -n1)
    [ -n "$real" ] || { echo "shit: real gh not found on PATH" >&2; exit 127; }
    exec "$real" "$@"
fi

# Locate the real gh (first non-wrapper entry on PATH).
real=$(PATH="${PATH#*$(dirname "$0"):}" command -v gh 2>/dev/null || command -v -- gh)
[ -n "$real" ] || { echo "shit: real gh not found on PATH" >&2; exit 127; }

# DR-CR-06: pre/post hooks via `shit-helper cloud-event` go here.
# Stage 1: just exec.
exec "$real" "$@"
