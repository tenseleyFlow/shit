#!/usr/bin/env bash
# shit pkill wrapper — installed as $XDG_CONFIG_HOME/shit/bin/pkill.
# Brackets the invocation with `shit-helper proc-event pkill {pre,post}`
# so the daemon snapshots pattern-matched target state BEFORE the
# kill.
#
# SPDX-License-Identifier: AGPL-3.0-or-later

set -u
depth="${SHIT_WRAPPER_DEPTH:-0}"
if [[ "$depth" -ge 2 ]]; then exit 127; fi
export SHIT_WRAPPER_DEPTH=$((depth + 1))

HELPER="${SHIT_HELPER:-/usr/local/bin/shit-helper}"

self_realpath="$(readlink -f "$0" 2>/dev/null || echo "$0")"
basename="$(basename "$0")"
real=""
for cand in "/usr/bin/$basename" "/bin/$basename" "/usr/sbin/$basename"; do
    if [[ -x "$cand" ]]; then
        cand_real="$(readlink -f "$cand" 2>/dev/null || echo "$cand")"
        if [[ "$cand_real" != "$self_realpath" ]]; then
            real="$cand"
            break
        fi
    fi
done
[[ -z "$real" ]] && { echo "shit-$basename-wrapper: real $basename not found" >&2; exit 127; }

if [[ -n "${SHIT_DURING_UNDO:-}" ]]; then exec "$real" "$@"; fi

# Read-only flags: -l (display name), -c (count), --help, --version.
for tok in "$@"; do
    case "$tok" in
        --help|--version|-l|-c) exec "$real" "$@" ;;
    esac
done

argv_blob=""
for tok in "$@"; do
    if [[ -z "$argv_blob" ]]; then
        argv_blob="$tok"
    else
        argv_blob="$argv_blob"$'\n'"$tok"
    fi
done

"$HELPER" proc-event "$basename" pre "--target-argv=$argv_blob" 2>/dev/null || true
"$real" "$@"
rc=$?
"$HELPER" proc-event "$basename" post "--target-argv=$argv_blob" 2>/dev/null || true
exit "$rc"
