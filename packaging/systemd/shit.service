# shit daemon systemd user unit template.
# Substituted at install time:
#   @@SHITD_BIN@@    — absolute path to the shitd binary
#   @@CONFIG_PATH@@  — absolute path to the shitd config file
#
# Install: ~/.config/systemd/user/shit.service
# Enable:  systemctl --user enable --now shit.service

[Unit]
Description=shit daemon — magic undo for the command line
Documentation=https://github.com/tenseleyFlow/shit

[Service]
Type=exec
ExecStart=@@SHITD_BIN@@ --foreground --config @@CONFIG_PATH@@

Restart=on-failure
RestartSec=10

# No sandboxing directives. NoNewPrivileges=true stops exec from granting
# the helper's file capabilities, so it cannot be set here.
# shitd spawns shit-helper, which gets its
# privileges from file capabilities (cap_bpf, cap_perfmon, cap_sys_admin);
# NoNewPrivileges=true would stop exec from granting them. In a user manager
# the Protect*, Restrict* and LockPersonality options also fail with
# status=218/CAPABILITIES when unprivileged user namespaces are restricted
# (Ubuntu 24.04 hosted runners).

[Install]
WantedBy=default.target
