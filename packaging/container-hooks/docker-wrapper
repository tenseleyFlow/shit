#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
# C04 container wrapper: docker. PATH-prepended under
# $XDG_CONFIG_HOME/shit/bin/ when `shit container-hooks install` runs.
#
# Pre/post capture invocations of `shit-helper container-event docker ...`
# are gated on DR-CR-21/26 (daemon-side container capture pipeline +
# helper subcommand). Stage 1 just execs the real docker with
# SHIT_DURING_UNDO recursion guard.

set -e

# Recursion guard: a docker invocation issued FROM the helper itself
# (during a shit undo) must NOT re-capture. The executors set
# SHIT_DURING_UNDO=1.
if [ "${SHIT_DURING_UNDO:-}" = "1" ]; then
    real=$(command -v -- docker | grep -v "$(dirname "$0")" | head -n1)
    [ -n "$real" ] || { echo "shit: real docker not found on PATH" >&2; exit 127; }
    exec "$real" "$@"
fi

# Locate the real docker (first non-wrapper entry on PATH).
real=$(PATH="${PATH#*$(dirname "$0"):}" command -v docker 2>/dev/null || command -v -- docker)
[ -n "$real" ] || { echo "shit: real docker not found on PATH" >&2; exit 127; }

# DR-CR-26 (AR03 PR-B): pre-capture via `shit-helper container-event`.
# The helper classifies the argv, runs `docker save` for destructive
# image verbs (rmi), and ships the tarball bytes inline to the daemon.
# Helper is hook-friendly: any failure logs and returns 0, so a torn
# daemon cannot break `docker`. Best-effort by design.
helper=$(command -v shit-helper 2>/dev/null || true)
# Debug breadcrumb (gated on SHIT_HOOK_DEBUG=1) so smokes can see the
# wrapper's path resolution without enabling shell -x.
if [ "${SHIT_HOOK_DEBUG:-}" = "1" ]; then
    echo "shit-hook: docker-wrapper real=${real} helper=${helper:-<not-found>}" >&2
fi
if [ -n "$helper" ]; then
    # Newline-separate the user's argv so the helper can split it
    # cleanly (NUL is awkward to ship through a CLI string flag).
    target_argv=$(printf '%s\n' "$@")
    "$helper" container-event docker pre --target-argv "$target_argv" || true
fi

exec "$real" "$@"
